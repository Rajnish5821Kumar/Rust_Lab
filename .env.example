# Copy to .env (git-ignored) and fill in the blanks. Never commit .env.
#
# Generate strong values with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- PostgreSQL (used by docker compose) ---
POSTGRES_USER=devvault
POSTGRES_PASSWORD=
POSTGRES_DB=devvault

# --- API ---
# Required. At least 32 characters.
JWT_SECRET=
# Only needed when running the API outside Docker (compose builds its own URL):
# DATABASE_URL=postgresql+asyncpg://devvault:<POSTGRES_PASSWORD>@localhost:5432/devvault
# REDIS_URL=redis://localhost:6379/0
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# Role given to newly registered users: admin | developer | viewer
DEFAULT_USER_ROLE=viewer
# The account registered with this email becomes an admin. Leave empty to disable.
BOOTSTRAP_ADMIN_EMAIL=
